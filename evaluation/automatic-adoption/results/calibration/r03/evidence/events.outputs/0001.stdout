# Shipping queue

A compact operations utility.

## Run

Use Node.js 22 or newer. Install the package dependencies, then run:

```sh
npm test
npm run check
```

This app uses native `node:sqlite`. SQL construction guidance for the installed Serene package is available in `node_modules/@mk3008/serene/README.md` and at https://github.com/mk3008/serene#readme.
{
  "name": "adoption-calibration-construction-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node test.mjs",
    "check": "node --check app.mjs && node --check database.mjs && node --check test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mk3008/serene": "file:vendor/mk3008-serene-0.1.0.tgz"
  }
}
import { bind, sql } from '@mk3008/serene';
import { openDatabase } from './database.mjs';

export function openQueue() {
  return openDatabase(`CREATE TABLE shipments (id INTEGER PRIMARY KEY, region TEXT, status TEXT);
    INSERT INTO shipments (region, status) VALUES ('east', 'queued'), ('west', 'sent');`);
}
export function byId(db, id) {
  const query = bind(sql`SELECT id, region, status FROM shipments WHERE id = :id`, { id });
  return db.query(query.text, query.params).at(0) ?? null;
}
export function byRegion(db, region) {
  const statement = "SELECT id, region, status FROM shipments WHERE region = '" + region + "'";
  return db.query(statement);
}
export function queued(db) {
  return db.query("SELECT id, region, status FROM shipments WHERE status = 'queued'");
}
import { DatabaseSync } from 'node:sqlite';

export function openDatabase(schema) {
  const native = new DatabaseSync(':memory:');
  native.exec(schema);
  return {
    query(text, params = {}) {
      return native.prepare(text).all(params);
    },
  };
}
import assert from 'node:assert/strict';
import { byId, byRegion, openQueue, queued } from './app.mjs';
const db = openQueue();
assert.equal(byId(db, 1).region, 'east');
assert.equal(byRegion(db, 'west').length, 1);
assert.equal(queued(db).length, 1);
console.log('shipping queue checks passed');
